<?xml version="1.0" encoding="UTF-8"?>
<!-- Abra em https://demo.bpmn.io (File > Open) ou no Camunda Modeler para visualizar/exportar PNG -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_AgroConecta" targetNamespace="http://agroconecta/bpmn">
  <bpmn:collaboration id="Colab">
    <bpmn:participant id="Pool" name="Robô de Cotações AgroConecta (n8n)" processRef="ProcessoCotacoes" />
  </bpmn:collaboration>

  <bpmn:process id="ProcessoCotacoes" name="Coleta diária de cotações" isExecutable="false">
    <bpmn:startEvent id="Inicio" name="Todo dia 07:30">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Iniciar execução (gerar id, abrir .log)">
      <bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T2" name="Acessar portal CEAGESP e ler datas disponíveis">
      <bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Portal acessível?">
      <bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>fNao1</bpmn:outgoing><bpmn:outgoing>fSim1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TFalha" name="Registrar FALHA e avisar administradores">
      <bpmn:incoming>fNao1</bpmn:incoming><bpmn:outgoing>fFalha</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FimFalha" name="Execução com falha">
      <bpmn:incoming>fFalha</bpmn:incoming>
      <bpmn:errorEventDefinition id="Err0" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T3" name="Selecionar próxima categoria (FRUTAS, LEGUMES...)">
      <bpmn:incoming>fSim1</bpmn:incoming><bpmn:incoming>fLoop</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Há boletins não coletados?">
      <bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>fNao2</bpmn:outgoing><bpmn:outgoing>fSim2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T4" name="Consultar boletim da data (POST + retentativas)">
      <bpmn:incoming>fSim2</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics />
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="ErroConsulta" name="Erro / layout alterado" attachedToRef="T4">
      <bpmn:outgoing>fErro</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Err1" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T5" name="Validar e padronizar (regras R1–R7, pandas)">
      <bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Gravar válidos (upsert) e rejeitados no Supabase">
      <bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T7" name="Registrar erro no log e seguir para o próximo">
      <bpmn:incoming>fErro</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4">
      <bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>fNao2</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="Mais categorias?">
      <bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>fLoop</bpmn:outgoing><bpmn:outgoing>fNao3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T8" name="Gerar alertas (≥ 15%) e avisar produtores no Telegram">
      <bpmn:incoming>fNao3</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T9" name="Definir status e gravar log (execucoes_rpa + logs_rpa)">
      <bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fim" name="Cotações disponíveis no MVP">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="f1" sourceRef="Inicio" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="fNao1" name="Não" sourceRef="G1" targetRef="TFalha" />
    <bpmn:sequenceFlow id="fFalha" sourceRef="TFalha" targetRef="FimFalha" />
    <bpmn:sequenceFlow id="fSim1" name="Sim" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="f4" sourceRef="T3" targetRef="G2" />
    <bpmn:sequenceFlow id="fSim2" name="Sim" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="fNao2" name="Não" sourceRef="G2" targetRef="G4" />
    <bpmn:sequenceFlow id="f5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="f6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="f7" sourceRef="T6" targetRef="G4" />
    <bpmn:sequenceFlow id="fErro" sourceRef="ErroConsulta" targetRef="T7" />
    <bpmn:sequenceFlow id="f8" sourceRef="T7" targetRef="G4" />
    <bpmn:sequenceFlow id="f9" sourceRef="G4" targetRef="G3" />
    <bpmn:sequenceFlow id="fLoop" name="Sim" sourceRef="G3" targetRef="T3" />
    <bpmn:sequenceFlow id="fNao3" name="Não" sourceRef="G3" targetRef="T8" />
    <bpmn:sequenceFlow id="f10" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="f11" sourceRef="T9" targetRef="Fim" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Colab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="100" y="80" width="1800" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio"><dc:Bounds x="150" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="230" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="380" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="530" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TFalha_di" bpmnElement="TFalha"><dc:Bounds x="505" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FimFalha_di" bpmnElement="FimFalha"><dc:Bounds x="537" y="480" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="630" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="780" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="880" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErroConsulta_di" bpmnElement="ErroConsulta"><dc:Bounds x="912" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1030" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1180" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1030" y="330" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G4_di" bpmnElement="G4" isMarkerVisible="true"><dc:Bounds x="1330" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="1430" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1530" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="1680" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fim_di" bpmnElement="Fim"><dc:Bounds x="1832" y="222" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="186" y="240" /><di:waypoint x="230" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="330" y="240" /><di:waypoint x="380" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="480" y="240" /><di:waypoint x="530" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNao1_di" bpmnElement="fNao1"><di:waypoint x="555" y="265" /><di:waypoint x="555" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fFalha_di" bpmnElement="fFalha"><di:waypoint x="555" y="420" /><di:waypoint x="555" y="480" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fSim1_di" bpmnElement="fSim1"><di:waypoint x="580" y="240" /><di:waypoint x="630" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="730" y="240" /><di:waypoint x="780" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fSim2_di" bpmnElement="fSim2"><di:waypoint x="830" y="240" /><di:waypoint x="880" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNao2_di" bpmnElement="fNao2"><di:waypoint x="805" y="215" /><di:waypoint x="805" y="130" /><di:waypoint x="1355" y="130" /><di:waypoint x="1355" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="980" y="240" /><di:waypoint x="1030" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="1130" y="240" /><di:waypoint x="1180" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1280" y="240" /><di:waypoint x="1330" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fErro_di" bpmnElement="fErro"><di:waypoint x="930" y="298" /><di:waypoint x="930" y="370" /><di:waypoint x="1030" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="1130" y="370" /><di:waypoint x="1355" y="370" /><di:waypoint x="1355" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1380" y="240" /><di:waypoint x="1430" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fLoop_di" bpmnElement="fLoop"><di:waypoint x="1455" y="265" /><di:waypoint x="1455" y="470" /><di:waypoint x="680" y="470" /><di:waypoint x="680" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fNao3_di" bpmnElement="fNao3"><di:waypoint x="1480" y="240" /><di:waypoint x="1530" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1630" y="240" /><di:waypoint x="1680" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1780" y="240" /><di:waypoint x="1832" y="240" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
